# Local development config (Build It track)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Valkey / Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_SECONDS=2592000

# SQS queue names
TEXT_QUEUE_NAME=moderation-text-queue
IMAGE_QUEUE_NAME=moderation-image-queue

# S3 bucket
S3_BUCKET_NAME=moderation-images

# Model provider: "ollama" for local, "bedrock" for AWS
MODEL_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Webhook (for demo testing)
WEBHOOK_URL=https://webhook.site/your-unique-id 